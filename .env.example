# dsh-cloud 控制面配置。
#
# 本地开发**不用手动复制这份文件**：根目录 `pnpm dev` 会在缺失时生成
# apps/server/.env.local（含两个随机 secret），填的就是下面注释里那组 lvh.me 形态。
# 这份模板是给生产 / 自己写 compose 用的，示例值是生产域名 + :443。
# 校验规则见 apps/server/src/env.ts，缺必填项进程直接起不来。
#
# 本地形态（见 docker/compose/local.yml）：
#   BASE_DOMAIN=lvh.me、CONSOLE_DOMAIN=console.lvh.me、PUBLIC_SCHEME=https、
#   TRAEFIK_ENTRYPOINT=websecure、TRAEFIK_CERT_RESOLVER=（留空）、
#   INSTANCE_UPSTREAM_HOST=host.docker.internal（Traefik 是容器，够不到自己的回环）、
#   FORWARD_AUTH_ADDRESS=http://host.docker.internal:3000/auth/verify、
#   TRAEFIK_ROUTES_PATH=./traefik-dynamic/routes.yml、WEB_DIST_DIR=（留空，管理台交给 Vite）
# 浏览器访问 https://console.lvh.me：Traefik 没配证书，回落到内置默认自签证书，
# 会红锁，点「继续访问」即可（见 D26）。
# **别用 localhost 当域名**：它和 lvh.me 形态不是一套，会话 cookie 的域也不同。
#
# 生产形态（scripts/install.sh 会写）见文件末尾「生产部署」那段。

# ── 必填 ────────────────────────────────────────────────────────────────

# Postgres 连接串
DATABASE_URL=postgres://dshcloud:dshcloud@127.0.0.1:55432/dsh_cloud

# 父域：实例子域挂在它下面（<slug>.app.example.com）。会话 cookie 也种在它上面，
# 所以它必须同时覆盖控制台和实例。
#
# **两项都留空 = 引导态**：平台只暴露引导页，域名由操作者在那一页里填、之后落进 DB。
# 这里填了值就**压过** DB —— 本地开发（lvh.me）和手工覆盖走这档。见 D36。
BASE_DOMAIN=app.example.com

# 控制台自己的主机名，必须是 BASE_DOMAIN 的子域（console.<BASE_DOMAIN>），
# 不能是 BASE_DOMAIN 本身——父域那一层不当主机名用，留给实例命名空间。
CONSOLE_DOMAIN=console.app.example.com

# 派生实例桥的 gate token（每实例一把，D8 ③）。轮换后必须重建实例容器，否则桥 403。
# 生成：openssl rand -hex 32
PLATFORM_SECRET=

# 签会话 cookie。与 PLATFORM_SECRET 分开——密钥轮换的影响面不同，不该共用一把。
# 生成：openssl rand -hex 32
BETTER_AUTH_SECRET=

# **引导态**的一次性凭证（安装脚本生成、打印一次）。留空 = 不接受 setup 写请求。
# 它只在没配域名时有用：配好之后引导口被摘掉、这个端点也不再接受写。见 D36。
SETUP_TOKEN=

# ── 有默认值 ────────────────────────────────────────────────────────────
# 控制面监听端口（只绑回环，由入口接入）
PORT=3000

# 生成对外 URL 用
PUBLIC_SCHEME=https

# 管理台静态文件目录。**留空 = 不 serve**（本地由 Vite dev server 提供，这条路不注册）。
# 平台镜像里是 /app/web：控制面同源提供管理台，不需要第二个容器或 nginx（见 D32）。
WEB_DIST_DIR=

# 仅本地开发：额外受信来源，逗号分隔，用于 Vite 等开发端口。
# 生产必须留空，否则启动拒绝；生产管理台与 API 同源，只信任控制台自身来源。
EXTRA_TRUSTED_ORIGINS=

# TRAEFIK_CONTAINER 已删：它对应的 D3（把 Traefik 接进每个实例网络）从未实现，全仓没有任何
# 代码读它。生产入口改走 host 网络，见 D33。

# 实例路由挂的 entryPoint。生产是 websecure（TLS 终结在 Traefik）。
TRAEFIK_ENTRYPOINT=websecure

# 实例 router 用的 ACME resolver 名（对应 traefik.yml 的 certificatesResolvers）。
# 留空 = 不挂 resolver，证书走 file provider 的静态证书按 SNI 匹配。
# 本地没有静态证书，落到 Traefik 的默认自签证书；生产是把 Cloudflare Origin Certificate
# 之类的证书放进 file provider（TLS 在边缘终结时也是这一档）。
# 生产默认是 le：逐主机 ACME HTTP-01（控制台一张、每个实例子域一张），见 D34。
TRAEFIK_CERT_RESOLVER=

# 实例后端的**上游主机名**——入口拿它去连实例发布在宿主回环上的端口。
# 默认 127.0.0.1（入口跑在宿主上时正确，生产就是这档）。本地开发里入口是**容器**，
# 它自己的 127.0.0.1 不是宿主，得改成 host.docker.internal，否则 502。
INSTANCE_UPSTREAM_HOST=127.0.0.1

# 每个用户默认能开几个实例；单用户覆盖值在 user.instance_quota。
MAX_INSTANCES_PER_USER=3

# 控制面 listen 地址。默认 0.0.0.0——Linux 上 Traefik 在容器、控制面在宿主时，
# host-gateway 摸不到宿主 loopback，必须绑全接口（或真实宿主 IP）。
# 同时作用于 workspace-gateway（Traefik → host.docker.internal:gatewayPort）。
# Docker Desktop 可改回 127.0.0.1。生产仍应由反向代理对外。见 docs/FORK.md。
# CONTROL_PLANE_LISTEN_HOST=0.0.0.0

# 平台级资源封顶（全局；本版无每用户资源封顶）。创建过则创建/改档拒绝。
# PLATFORM_MAX_CPUS=2
# PLATFORM_MAX_MEMORY_MB=2048
# PLATFORM_MAX_PIDS=512
# PLATFORM_MAX_DISK_MB=10240
# 同时 running 上限；0 = 不限制。
# PLATFORM_MAX_RUNNING=3
# 空闲回收（分钟）；0 = 关闭。
# PLATFORM_IDLE_CULL_MINUTES=45

# 实例数据池的根。池化之后每实例是这下面的一个子目录 + 一个 XFS project ID（**硬配额**），
# 不再是 Docker 命名卷。要求它落在一块 **XFS 且以 pquota 挂载**的文件系统上；不是的话
# **安装脚本会在宿主上**建一块 loopback XFS 镜像（<root>.img）挂上来当池子 —— 那一步要宿主 root，
# 且必须写进 fstab / mount unit，否则重启后池子没了（见 D35）。
# 两条都做不到时：Linux 上**拒绝启动**（没有真配额就不该跑），macOS 上退化为「不强制 + 一行警告」。
HOST_STORAGE_ROOT=/var/lib/dsh

# 池子大小（MiB）—— **只在平台自动建 loopback 镜像时用**，且**只在首次建池生效**。
# 省略 = 取宿主该文件系统的 80%。
# HOST_POOL_SIZE_MB=102400

# 平台自己的实例镜像仓库（D22）。发布准入和「宿主上可发布」都按它过滤。
# 本地 docker/instance-image/build.sh 打的是同一个全名（只是没推上去）。
INSTANCE_IMAGE_REPO=ghcr.io/eskim2001/dsh-instance

# 读注册表 tag 用的凭据（D23 的「同步」/「下载」）。包是**公开**的，默认留空走匿名 token 换取；
# 只有在包转私有、或撞到匿名限流时才填（两个都填才生效，只填一个当匿名）。
INSTANCE_IMAGE_REGISTRY_USER=
INSTANCE_IMAGE_REGISTRY_TOKEN=

# ── 生产部署（scripts/install.sh 会写这几项）────────────────────────────
# 下面两项不在 env.ts 里（控制面直接读 process.env），生产必须显式给。
# 控制面渲染给 Traefik 的动态路由文件（真相源是 DB）
# TRAEFIK_ROUTES_PATH=/etc/traefik/dynamic/routes.yml
# 入口调 forward-auth 的地址。生产入口在 host 网络上，127.0.0.1 就是宿主回环。
# FORWARD_AUTH_ADDRESS=http://127.0.0.1:3000/auth/verify
# 另外生产还要 INSTANCE_UPSTREAM_HOST=127.0.0.1、WEB_DIST_DIR=/app/web、TRAEFIK_CERT_RESOLVER=le，
# 见上面各自的说明。ACME 的**邮箱**不在这份文件里——它渲染进 Traefik 的静态配置。
# SELF_CONTAINER（控制面自己的容器名，配完域名要重启自己时靠它定位）由 compose 写死，
# 与 container_name 挨着，一般不用在这儿给。

# ── 本地 / 特殊部署 ────────────────────────────────────────────────────
# 本地那套（入口是容器，只在 Docker Desktop 上成立，见 D33）：
#   FORWARD_AUTH_ADDRESS=http://host.docker.internal:3000/auth/verify、
#   TRAEFIK_ROUTES_PATH=./traefik-dynamic/routes.yml。
# `pnpm dev` 会把这些写进 apps/server/.env.local。

# ── 首次初始化（pnpm --filter @dsh-cloud/server db:seed）──────────────────
# 只在「还没有管理员」时生效。之后权限在管理台里改，所以可以重复跑
# （也是被删光后的恢复路径）。镜像版本不在这里引导——去「镜像管理」页发布并设为默认。
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# 可选，缺省取邮箱 @ 前那段
SEED_ADMIN_NAME=
